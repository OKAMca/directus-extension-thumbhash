{
  "name": "directus-extension-thumbhash",
  "private": true,
  "description": "Directus ThumbHash Extension",
  "icon": "extension",
  "version": "0.0.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/WoLfulus/directus-extension-thumbhash"
  },
  "author": {
    "name": "WoLfulus",
    "email": "wolfulus@gmail.com"
  },
  "files": [
    "dist/index.js",
    "src/index.ts",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-custom-hook"
  ],
  "directus:extension": {
    "type": "hook",
    "path": "./dist/dist/index.js",
    "source": "./src/index.ts",
    "host": "10.0.0"
  },
  "scripts": {
    "build": "directus-extension build && pnpm build:pkg && pnpm run /copy:.*/",
    "build:pkg": "wtx package prepare",
    "build:dev": "directus-extension build --no-minify && wtx package prepare && pnpm copy:src",
    "copy:src": "wtx files copy --source ./src --target ./dist/src",
    "copy:info": "wtx files copy --source.base ./ --source.files {README.md,LICENSE} --target ./dist/",
    "dev": "nodemon --watch src/ -e ts --exec \"pnpm build:dev\""
  },
  "devDependencies": {
    "@directus/extensions-sdk": "17.1.4",
    "@directus/types": "15.0.3",
    "@types/node": "^20.3.1",
    "@wolfpkgs/files": "^0.2.9",
    "@wolfpkgs/package": "^0.2.10",
    "@wolfpkgs/pnpm": "^0.2.10",
    "@wolfpkgs/toolbox": "^0.2.9",
    "@wolfpkgs/tsconfig": "^0.2.0",
    "nodemon": "^2.0.22",
    "typescript": "^5.1.3"
  },
  "peerDependencies": {
    "sharp": "^0.33 || ^0.34 || ^0.35"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": false
    }
  },
  "dependencies": {
    "thumbhash": "^0.1.1"
  },
  "publishConfig": {
    "directory": "dist",
    "linkDirectory": false,
    "overrides": {
      "private": false,
      "directus:extension": {
        "type": "hook",
        "path": "./dist/index.js",
        "source": "./src/index.ts",
        "host": "10.3.0"
      }
    }
  },
  "pnpm": {
    "overrides": {
      "@unhead/vue": "2.1.17",
      "axios": "1.21.0",
      "deepmerge": "npm:@shivammathur/deepmerge@4.3.2",
      "joi": "18.3.1",
      "js-yaml": "4.3.2",
      "nanoid@5": "5.1.16",
      "semver@>=7 <7.5.2": "^7.5.2",
      "vite": "8.3.5",
      "vue": "^3.5.45",
      "zod": "4.6.7"
    },
    "patchedDependencies": {
      "@wolfpkgs/core@0.2.13": "patches/@wolfpkgs__core@0.2.13.patch",
      "@wolfpkgs/files@0.2.13": "patches/@wolfpkgs__files@0.2.13.patch",
      "@wolfpkgs/package@0.2.14": "patches/@wolfpkgs__package@0.2.14.patch",
      "@wolfpkgs/pnpm@0.2.14": "patches/@wolfpkgs__pnpm@0.2.14.patch",
      "zod-validation-error@1.5.0": "patches/zod-validation-error@1.5.0.patch"
    }
  }
}
